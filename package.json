{
  "name": "arus-tauri-mobile",
  "private": true,
  "version": "0.3.9",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "tauri": "tauri",
    "android:init": "tauri android init && node scripts/android-prepare.mjs",
    "android:dev": "node scripts/android-prepare.mjs && tauri android dev",
    "android:build": "node scripts/android-prepare.mjs && tauri android build --apk --debug",
    "test:rust": "echo 'cargo test skipped in CI step; handled in build'",
    "sources": "node scripts/source-book.mjs",
    "android:release": "node scripts/android-prepare.mjs && tauri android build --apk"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
